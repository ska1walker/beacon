# Nur für die lokale Entwicklung. Auf der Box injiziert Olares diese Werte.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=beacon
DB_USER=beacon
DB_PASSWORD=beacon_dev_only
# Ohne Envoy gibt es keinen X-Bfl-User-Header. Lokal tut dieser Name so,
# als wäre jemand angemeldet. Auf der Box bleibt DEV_USER leer.
DEV_USER=
# Auf der Box: /app/data (überlebt die Deinstallation)
APP_DATA_DIR=/app/data
